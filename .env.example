# Leave empty when the frontend and the /api backend are served from the same domain (current setup).
# Set it to e.g. https://api.example.com if the API moves to its own host (the app appends /api).
VITE_BACKEND_URL=

# Development only: where `npm run dev` proxies /api requests.
VITE_DEV_API_TARGET=https://chat-bot-omega-orpin.vercel.app
